{
  "name": "just-qr",
  "private": true,
  "version": "0.1.0",
  "description": "QR codes that never expire. No account, no ads, no tracking.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "node scripts/check.mjs",
    "check-i18n": "node scripts/check-i18n.mjs",
    "check-size": "node scripts/check-size.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test": "npm run build && playwright test --project=phone --project=phone-ar",
    "test:all": "npm run build && playwright test",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.1.0",
    "jsqr": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "zxing-wasm": "^3.1.6"
  }
}
