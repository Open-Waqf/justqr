{
  "name": "just-qr",
  "private": true,
  "version": "0.1.0",
  "description": "QR codes that never expire. No account, no ads, no tracking.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "node scripts/check.mjs",
    "check-i18n": "node scripts/check-i18n.mjs",
    "check-size": "node scripts/check-size.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test": "npm run build && playwright test --project=phone --project=phone-ar",
    "test:all": "npm run build && playwright test",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "android:run": "node scripts/run-android.mjs",
    "android:live": "node scripts/run-android.mjs --live",
    "test:android": "node scripts/test-android.mjs",
    "android:build": "npm run build && npx cap sync android && cd android && ./gradlew --no-daemon -q assembleDebug assembleRelease",
    "check:android": "node scripts/check-android.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "idb": "^8.0.4",
    "lit": "^3.3.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.4",
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.1.0",
    "fake-indexeddb": "^6.2.7",
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "zxing-wasm": "^3.1.6"
  }
}
